NEXTAUTH_URL=https://www.thegarmentguy.in
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
# AUTH_SECRET may be used as an alias by some Auth.js setups.
# Keep it equal to NEXTAUTH_SECRET if both are configured.
AUTH_SECRET=replace-with-the-same-strong-random-secret
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
AUTH_DEBUG=false
